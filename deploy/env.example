# /etc/radar/env — radar 生产环境变量（复制后填值，勿提交真实机密）
#
# 安装：sudo install -D -m 600 deploy/env.example /etc/radar/env

# ── LLM（默认 yunwu MiniMax-M2.7）───────────────────────────────────────
LLM_PROFILE=yunwu
YUNWU_API_KEY=
YUNWU_BASE_URL=https://yunwu.ai/v1
YUNWU_MODEL=MiniMax-M2.7
# zhipu GLM-5.1 已就绪：拿到有效 key 后改 LLM_PROFILE=zhipu + 填 ZHIPU_API_KEY
# ZHIPU_API_KEY=

# ── 数据库 ──────────────────────────────────────────────────────────────
# 生产建议 PostgreSQL；小规模可用 SQLite（无需额外服务）。
# DATABASE_URL=postgresql+asyncpg://radar:radar@localhost:5432/radar
# SYNC_DATABASE_URL=postgresql+psycopg2://radar:radar@localhost:5432/radar
# DATABASE_URL=sqlite+aiosqlite:////home/ai/radar/radar.db
# SYNC_DATABASE_URL=sqlite:////home/ai/radar/radar.db

# ── Web（仅本机；公网经 cloudflared）────────────────────────────────────
WEB_HOST=127.0.0.1
WEB_PORT=7090

# ── 数据源凭证 ──────────────────────────────────────────────────────────
# GITHUB_TOKEN=
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=

# ── 存储控制 ────────────────────────────────────────────────────────────
# 原始抓取 payload 保留天数（0=永久）。设非 0 让 radar 周期清理，
# 控制磁盘占用。
RAW_BLOB_RETENTION_DAYS=30

# ── heyi-eval 实测结果回流 ──────────────────────────────────────────────
# radar 同机只读 heyi-eval 的 lane run 目录，渲染「实测结果」页。
HEYI_EVAL_DATA=/home/ai/heyi-eval-data
