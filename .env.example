# ============================================================
# Radar 环境变量配置示例
# 复制为 .env 后填入真实值，不要把 .env 提交到 git
# ============================================================

# ── 数据库 ────────────────────────────────────────────────────
# PostgreSQL（默认，推荐）
DATABASE_URL=postgresql+asyncpg://radar:radar@localhost:5432/radar
SYNC_DATABASE_URL=postgresql+psycopg2://radar:radar@localhost:5432/radar

# SQLite 纯本地模式（pure-local profile）
# DATABASE_URL=sqlite+aiosqlite:///./radar.db
# SYNC_DATABASE_URL=sqlite:///./radar.db

# ── LLM Profile ────────────────────────────────────────────────
# 可选: zhipu / heyi / yunwu / ollama / openai
LLM_PROFILE=zhipu

# zhipu（智谱 GLM-5.1，OpenAI 兼容云 API）—— 默认
ZHIPU_API_KEY=your-zhipu-key-here
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-5.1

# yunwu（云雾，OpenAI 兼容代理）
YUNWU_API_KEY=sk-your-yunwu-key-here
YUNWU_BASE_URL=https://yunwu.ai/v1
YUNWU_MODEL=gpt-5.4-mini

# heyi（褐蚁本地 GPU，通过 Tailscale/内网访问）
HEYI_API_KEY=sk-heyi-local
HEYI_BASE_URL=http://heyi.local:8000/v1
HEYI_MODEL=qwen3-235b

# ollama（纯本地，开源用户友好）
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b
OLLAMA_API_KEY=ollama

# ── GitHub 数据源 ──────────────────────────────────────────────
# 创建：https://github.com/settings/tokens/new
# 需要 scopes: public_repo, read:org
GITHUB_TOKEN=ghp_your_token_here

# ── Reddit 数据源 ──────────────────────────────────────────────
# 创建：https://www.reddit.com/prefs/apps（选 script 类型）
REDDIT_CLIENT_ID=your_client_id
REDDIT_CLIENT_SECRET=your_client_secret
REDDIT_USERNAME=your_username
REDDIT_PASSWORD=your_password
REDDIT_USER_AGENT=radar/0.1.0 by your_username

# ── 报告配置 ──────────────────────────────────────────────────
# 每日自动渲染时间（cron 表达式）
REPORT_PROJECTS_CRON=0 6 * * *
REPORT_COMMUNITIES_CRON=0 6 * * *

# 报告保留天数
REPORT_RETENTION_DAYS=90

# ── Web UI ──────────────────────────────────────────────────
WEB_HOST=0.0.0.0
WEB_PORT=7090
WEB_DEBUG=false

# ── 监控引擎 ──────────────────────────────────────────────────
# token 临近过期提醒（小时）
TOKEN_EXPIRY_WARNING_HOURS=48

# source 连续失败多少次触发 Incident
SOURCE_FAIL_THRESHOLD=5

# 数据多久无更新触发 stale（秒，默认 2 倍抓取频率，即 2h）
DATA_STALE_SECONDS=7200

# 磁盘空余低于多少 GB 告警
DISK_LOW_GB=5

# 是否启用 macOS 本地通知
MACOS_NOTIFY=true

# ── 抓取配置 ──────────────────────────────────────────────────
# GitHub 抓取频率（默认 6 小时）
GITHUB_CRAWL_INTERVAL=6h

# Reddit 抓取频率（默认 1 小时）
REDDIT_CRAWL_INTERVAL=1h

# 每次抓取最大条目数（防止首次全量太大）
MAX_ITEMS_PER_RUN=500

# raw blob 保留策略：永久=0，否则填天数
RAW_BLOB_RETENTION_DAYS=0

# ── 安全 ─────────────────────────────────────────────────────
# 凭证加密密钥（32 字节 base64，使用 `radar init` 自动生成）
CREDENTIAL_ENCRYPTION_KEY=

# ── 日志 ─────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=./logs
